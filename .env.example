# Defaults to testnet. Switch BASE_URL to https://fapi.binance.com for live trading.
DRY_RUN=true
BASE_URL=https://testnet.binancefuture.com
BINANCE_API_KEY=
# Path (inside the container) to the Ed25519 private key whose public key you uploaded to Binance
BINANCE_ED25519_PRIVATE_KEY_PATH=keys/private.pem

NOTIONAL=800.0
LEVERAGE=10
MARGIN_FRACTION_PER_LEG=0.40
ENTRY_ORDER_TYPE=LIMIT
FEE_RATE=0.0004
DAY_STOP_USD=-12.0
DAY_STOP_EQUITY_FRACTION=0.06
TP_PNL_FRACTION=0.0020
SL_PNL_FRACTION=0.0042
GAP_ENTER=0.0014
GAP_TP=0.0025   # unused: exits are PnL-based via TP_PNL_FRACTION
GAP_SL=0.0042   # unused: exits are PnL-based via SL_PNL_FRACTION
MAX_POLL_MOVE_PCT=0.0010
REQUIRE_GAP_REVERSAL=true
MAKER_TAKER_SEQUENCE=false
USE_WEBSOCKET_FILLS=true
# WS_BASE_URL=wss://stream.binancefuture.com   # auto-derived from BASE_URL if unset
WINDOW_SEC=900
FILL_WAIT_SEC=15
TIME_STOP_SEC=1500
MAX_HOLD_SEC=3000   # hard cap: a losing trade held past TIME_STOP_SEC is force-closed here regardless of P&L
POLL_SEC=2
ENTRY_COOLDOWN_SEC=30
BTC_STEP=0.001
ETH_STEP=0.001
# Trade win/loss history, written on every exit
CSV_PATH=data/trades.csv
EVENT_CSV_PATH=data/events.csv

# --- DCA bot (main.py). One USD-M symbol. Research stays in research/experiments/dca. ---
# Keep the compose service stopped while changing live-order logic.
# Clip is min(wallet, DCA_CLIP_USD). Sizing/SL use that pocket, not the whole account.
DCA_MARKET=um
DCA_SYMBOL=DOGEUSDT
DCA_INTERVAL=1m
DCA_MR_CAP=0.10
DCA_SL_LOSS=0.95
DCA_SL_FROM_LIQ=true
DCA_SO_STYLE=range
DCA_RANGE_SO_MAX=10
DCA_TP_PCT=0.08
DCA_HARD_SL_PCT=
DCA_HARD_SL_BASKET=1.0
DCA_STALE_LOSS_PCT=0.40
DCA_STALE_DAYS=180
DCA_MAX_HOLD_DAYS=
DCA_LEVERAGE=25
DCA_MARGIN_TYPE=CROSSED
DCA_WALLET_FIELD=wallet
DCA_CLIP_USD=10000
DCA_PEAK_SKIP_PCT=0.15
DCA_PEAK_LOOKBACK_DAYS=180
DCA_HEDGE=true
DCA_POLL_SEC=15
DCA_STATE_PATH=data/dca_bot_state.json
DCA_ALLOW_ORDERS=false
DCA_CONFIRM_PRODUCTION=false
DCA_FLATTEN_ON_START=false
DCA_ENTRY_TTL_SEC=3600
# DCA_PAPER_WALLET=10000
# Klines for signals default to live fapi even if BASE_URL is testnet.
# DCA_KLINE_BASE=https://fapi.binance.com

